generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Each API endpoint we want to monitor
model Endpoint {
  id        String   @id @default(cuid())
  name      String   // Friendly name, e.g. "GitHub API"
  url       String   // The URL to ping, e.g. "https://api.github.com"
  method    String   @default("GET") // HTTP method: GET, POST, PUT, etc.
  headers   String?  // JSON string of headers, e.g. {"Authorization": "Bearer xxx"}
  body      String?  // Request body for POST/PUT requests
  group     String   @default("Default") // Group/category for organizing endpoints
  interval  Int      @default(300) // Check interval in seconds (default: 5 min)
  createdAt DateTime @default(now())
  checks    Check[]  // All the health checks for this endpoint
}

// Each health check result
model Check {
  id         String   @id @default(cuid())
  status     Int      // HTTP status code (200, 500, 0 if timeout)
  latency    Int      // Response time in milliseconds
  isUp       Boolean  // true if status is 2xx
  checkedAt  DateTime @default(now())
  endpoint   Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  endpointId String
}
